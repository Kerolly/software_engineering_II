# Copy this file to .env and adjust. Never commit .env.
# All values below are local-development placeholders, not real secrets.

# --- PostgreSQL ---
POSTGRES_USER=bytebee
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bytebee
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/bytebee
SPRING_DATASOURCE_USERNAME=bytebee
SPRING_DATASOURCE_PASSWORD=change-me

# --- Frontend (Vite) ---
FRONTEND_PORT=5173

# --- Logto (auth) ---
# Pin to a concrete release tag, not "latest".
LOGTO_VERSION=change-me
LOGTO_PORT=3001
LOGTO_ADMIN_PORT=3002
