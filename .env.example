# Copy this file to .env and adjust. Never commit .env.
# All values below are local-development placeholders, not real secrets.

# --- PostgreSQL ---
POSTGRES_USER=se2
POSTGRES_PASSWORD=change-me
POSTGRES_DB=se2
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/se2
SPRING_DATASOURCE_USERNAME=se2
SPRING_DATASOURCE_PASSWORD=change-me

# --- Frontend (Vite) ---
FRONTEND_PORT=5173

# --- Firebase Authentication ---
# Backend: the Firebase project id, used to validate the JWT issuer and audience.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Frontend: public web config of the Firebase app (not secret, but still per project).
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# Backend: service account JSON of the Firebase project (SECRET, used to create the first admins and to disable blocked users).
# Put the real value only in your local .env and in the environment of the deployment, never in git.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- First admins ---
# Created in Firebase on backend startup if missing, with the role ADMIN, and forced to change the password at first login.
# In production the backend refuses to start with this placeholder or with a password shorter than 12 characters.
ADMIN_BOOTSTRAP_EMAILS=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-now
