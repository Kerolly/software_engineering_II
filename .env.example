# Copy this file to .env and adjust. Never commit .env.
# All values below are local-development placeholders, not real secrets.

# --- PostgreSQL ---
POSTGRES_USER=se2
POSTGRES_PASSWORD=change-me
POSTGRES_DB=se2
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/se2
SPRING_DATASOURCE_USERNAME=se2
SPRING_DATASOURCE_PASSWORD=change-me

# --- Frontend (Vite) ---
FRONTEND_PORT=5173

# --- Logto (auth) ---
# Pinned to a concrete release tag, never "latest".
LOGTO_VERSION=1.45.0
LOGTO_PORT=3001
LOGTO_ADMIN_PORT=3002
